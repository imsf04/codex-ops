{
  "description": "Local result capture and compact-output guidance; no tool input rewrites or blocking decisions.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|compact",
      "hooks": [{
        "type": "command",
        "command": "& \"C:/Users/imsfp/.local/share/codex-runtimes/codex-ops-uv/Scripts/python.exe\" \"C:/Users/imsfp/code/dsh-ops/packages/codex-ops/hook.py\"",
        "commandWindows": "& \"C:/Users/imsfp/.local/share/codex-runtimes/codex-ops-uv/Scripts/python.exe\" \"C:/Users/imsfp/code/dsh-ops/packages/codex-ops/hook.py\"",
        "timeout": 5
      }]
    }],
    "PostToolUse": [{
      "matcher": "^Bash$|^mcp__",
      "hooks": [{
        "type": "command",
        "command": "& \"C:/Users/imsfp/.local/share/codex-runtimes/codex-ops-uv/Scripts/python.exe\" \"C:/Users/imsfp/code/dsh-ops/packages/codex-ops/hook.py\"",
        "commandWindows": "& \"C:/Users/imsfp/.local/share/codex-runtimes/codex-ops-uv/Scripts/python.exe\" \"C:/Users/imsfp/code/dsh-ops/packages/codex-ops/hook.py\"",
        "timeout": 5,
        "statusMessage": "Capturing large tool output"
      }]
    }]
  }
}
